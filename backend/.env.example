# Copy this file to .env and fill in your real values.
# On Render, set these as Environment Variables in the dashboard — no .env file needed.

# Required: your Google AI Studio / Vertex AI Gemini API key
GEMINI_API_KEY=your-gemini-api-key-here

# Optional overrides (defaults shown)
GEMINI_MODEL=gemini-1.5-flash
MAX_UPLOAD_MB=10

# CORS: set to your Vercel frontend URL in production (no trailing slash)
# Example: ALLOWED_ORIGINS=https://your-app.vercel.app
# For local dev:
ALLOWED_ORIGINS=http://localhost:5173
